      "milestones": [
        "M2",
        "M3"
      ],
      "supports": [
        "swap_tensors preserves the identity of each Python tensor object.",
        "It swaps Python classes, dictionaries, slots, and tensor content.",
        "The Python helper rejects weak references, different slots, and unsupported use counts.",
        "Python attribute exchange precedes the C++ weak-reference guards.",
        "The recipe provides module conversion and state loading extension points."
      ],
      "limitations": [
        "The public recipe gives no exception-atomicity guarantee.",
        "Pinned, stable, and main Python helper equality does not qualify the private proposal on TPU.",
        "C++ post-swap pointer storage changed between pinned and current source."
