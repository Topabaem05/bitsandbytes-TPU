    {
      "id": "XLA-04",
      "title": "Native functionalization fallback and XLA wrappers",
      "url": "https://github.com/pytorch/pytorch/blob/0fabc3ba44823f257e70ce397d989c8de5e362c1/aten/src/ATen/FunctionalizeFallbackKernel.cpp#L58",
