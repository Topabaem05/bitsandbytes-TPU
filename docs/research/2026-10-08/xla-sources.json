      "version_or_revision": "0fabc3ba44823f257e70ce397d989c8de5e362c1",
      "source_date": "2025-10-09",
      "date_basis": "Repository snapshot commit date; not file update date",
      "accessed_date": "2026-10-08",
      "milestones": [
        "M2",
        "M3"
      ],
      "supports": [
        "The native custom operator fallback rejects schemas with any alias information.",
        "The fallback synchronizes functional inputs before unwrapping them.",
        "The fallback wraps tensor results when an input is functional or the operator is a factory.",
        "Pinned and current XLA lift/lift_fresh can call MaybeWrapTensorToFunctional.",
        "XLA code generation identifies operations that must re-enable functionalization."
      ],
      "limitations": [
        "The project must keep the upstream out operator schemas.",
        "Generic fallback cannot establish mutable out operator support.",
        "Internal wrapper helpers do not supply a public stability guarantee."
      ],
