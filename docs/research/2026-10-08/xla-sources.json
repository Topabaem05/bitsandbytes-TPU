    {
      "id": "XLA-08",
      "title": "PyTorch/XLA matrix multiplication precision control",
      "url": "https://docs.pytorch.org/xla/master/tutorials/precision_tutorial.html",
      "publisher": "PyTorch/XLA maintainers",
      "kind": "official tutorial and API source",
      "version_or_revision": "master documentation; source 41398bfff334fc8d3b1c00be6ea8cc5411f6d6bf",
      "source_date": "2025-05-15",
      "date_basis": "Tutorial Date created and Last modified fields",
      "accessed_date": "2026-10-08",
      "milestones": [
        "M2",
        "M3",
        "M6",
        "M7"
      ],
      "supports": [
        "The public XLA control accepts default, high, and highest.",
        "The API describes default TPU operand precision as FP32 downcasting to BF16.",
        "The API describes high as three passes with approximately 14 bits of precision.",
        "The API describes highest as six passes with approximately 22 bits of precision.",
        "The tutorial recommends one precision setting at the start of a script.",
        "The tutorial shows a final-bit difference between highest and full FP32."
      ],
      "limitations": [
        "The tutorial wording about BF16 results must not be read as a guaranteed output dtype.",
        "The precision setting does not prove the cause of the project FP32 failure.",
        "The documentation does not promise bitwise CPU equality for highest."
      ],
      "related_sources": [
